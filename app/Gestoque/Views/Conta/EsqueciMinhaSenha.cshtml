@model Gestoque.Models.EsqueciMinhaSenhaViewModel
@{
    ViewBag.Title = "Esqueci Minha Senha";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestoque - Esqueci minha senha</title>

    <!-- Custom fonts for this template-->
    <link href="~/Content/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">
    <!-- Custom styles for this template-->
    <link href="~/Content/css/sb-admin-3.min.css" rel="stylesheet">
</head>
<body class="bg-gray-800">
    <div class="container">
        <!-- Outer Row -->
        <div class="row justify-content-center">
            <div class="col-xl-10 col-lg-12 col-md-9">
                <div class="card o-hidden border-0 shadow-lg my-5">
                    <div class="card-body p-0">
                        <div class="row">
                            <div class="col-lg-6 d-none d-lg-block bg-password-image"></div>
                            <div class="col-lg-6">
                                <div class="p-5">
                                    <div class="text-center">
                                        <h1 class="h4 text-gray-900 mb-2">Esqueceu sua senha?</h1>
                                        <p class="mb-4">Nós entendemos, isso sempre acontece né? Basta digitar seu usuário de login abaixo e nós lhe enviaremos um link no seu e-mail para redefinir sua senha!</p>
                                    </div>

                                    @using (Html.BeginForm("EsqueciMinhaSenha", "Conta", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
                                    {
                                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                        <form class="user">
                                            <div class="form-group">
                                                @Html.TextBoxFor(m => m.Login, new { @InputType = "email", @class = "form-control form-control-user", @id = "exampleInputEmail", placeholder = "Digite seu usuário de login..." })
                                                @Html.ValidationMessageFor(m => m.Login, "", new { @class = "text-danger" })
                                            </div>
                                            <input type="submit" class="btn btn-primary btn-user btn-block" value="Resetar Senha">
                                        </form>
                                        <h1></h1>

                                        @* Mesma mensagem para login existente ou não, para não revelar quais logins existem *@
                                        if (ViewBag.EmailEnviado == true)
                                        {
                                        <div class="alert alert-success">
                                            <strong>Pedido recebido!</strong> Se o usuário informado estiver cadastrado, um e-mail com o link de redefinição da senha foi enviado para o e-mail dele.
                                        </div>
                                        }
                                        <hr>
                                        <div class="text-center">
                                            @Html.ActionLink("Já tem uma conta? Clique aqui para entrar!", "Login", "Conta", null, new { @class = "small" })
                                        </div>
                                        }
                                    </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Bootstrap core JavaScript-->
    <script src="~/Content/vendor/jquery/jquery.min.js"></script>
    <!-- Validação depende do jQuery: precisa vir depois dele -->
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Content/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <!-- Core plugin JavaScript-->
    <script src="~/Content/vendor/jquery-easing/jquery.easing.min.js"></script>
    <!-- Custom scripts for all pages-->
    <script src="~/Content/js/sb-admin-2.min.js"></script>
</body>
</html>
